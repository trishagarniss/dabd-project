# Copy to .env and replace the demo keys before any non-local deployment.
FDP_API_KEY_ADMIN=replace-with-admin-key
FDP_API_KEY_OPERATOR=replace-with-operator-key
FDP_API_KEY_VIEWER=replace-with-viewer-key

FDP_QUALITY_THRESHOLD=0.95
FDP_ALLOWED_LATENESS_SEC=300
FDP_POLL_INTERVAL_SEC=15
FDP_BATCH_INTERVAL_SEC=86400
FDP_BTS_SAMPLE_SIZE=5000
KAFKA_BOOTSTRAP=redpanda:9092
POSTGRES_USER=fdp_user
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DB=flight_platform
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-password
